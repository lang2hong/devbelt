        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorTextFocus"
      },
      {
        "command": "dbclient.searchObjects",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      },
      {
        "command": "dbclient.searchConnections",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js && cd webview && npx vite build",
    "build:ext": "node esbuild.js",
    "build:webview": "cd webview && npx vite build",
    "dev": "node esbuild.js --watch",
