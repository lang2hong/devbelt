{
  "name": "devbelt",
  "version": "0.1.0",
  "private": true,
  "description": "devbelt — unified developer toolkit monorepo (VS Code DB client, web console, server)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/vsce-sign",
      "esbuild",
      "vue-demi"
    ]
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "dev": "pnpm --filter ./apps/vscode-ext run dev"
  }
}