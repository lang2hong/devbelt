    "configuration": {
      "title": "DB Client",
      "properties": {
        "dbclient.sync.auto": {
          "type": "string",
          "enum": [
            "off",
            "reminder",
            "silent"
          ],
          "default": "off",
          "description": "Automatic cloud sync mode. 'reminder' notifies on changes; 'silent' runs background sync (requires remembering the master password).",
          "markdownDescription": "自动云同步模式：`reminder` 变更时提示；`silent` 后台静默同步（需记住主密码）。"
        },
        "dbclient.sync.intervalMin": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Automatic sync interval in minutes. 0 disables the periodic timer.",
          "markdownDescription": "自动同步周期（分钟）。0 表示关闭定时同步。"
        },
        "dbclient.sync.rememberMaster": {
          "type": "boolean",
          "default": true,
          "description": "Remember the sync master password in OS secure storage to enable silent background sync.",
          "markdownDescription": "在本机安全存储中记住同步主密码，以启用后台静默同步（主密码从不上传）。"
        },
        "dbclient.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh",
            "en"
          ],
          "default": "auto",
          "description": "Extension language. auto follows VS Code display language.",
          "markdownDescription": "扩展语言。`auto` 跟随 VS Code 显示语言。"
        },
        "dbclient.format.indent": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 8,
          "description": "SQL formatting indent width (spaces).",
          "markdownDescription": "SQL 格式化缩进宽度（空格数）。"
        },
        "dbclient.format.keywordCase": {
          "type": "string",
          "enum": [
            "preserve",
            "upper",
            "lower"
          ],
          "default": "upper",
          "description": "SQL formatting keyword case.",
          "markdownDescription": "SQL 格式化关键字大小写。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbclient",
          "title": "DB Client",
          "icon": "resources/logo.svg"
        }
      ]
    },
    "views": {
      "dbclient": [
        {
          "id": "dbclient.explorer",
          "name": "%view.explorer%"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dbclient.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus"
      },
      {
