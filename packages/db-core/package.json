{
  "name": "@devbelt/db-core",
  "version": "0.1.0",
  "description": "Pure database connection/query core (no vscode dependency)",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sql": {
      "types": "./dist/sql/index.d.ts",
      "import": "./dist/sql/index.js",
      "default": "./dist/sql/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "pack:smoke": "node scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "sqlstring": "^2.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "@types/sqlstring": "^2.3.2",
    "vitest": "^4.1.10",
    "typescript": "^5.9.3"
  }
}