    "configuration": {
      "title": "DB Client",
      "properties": {
        "dbclient.sync.serverUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "DB Client sync server URL"
        },
        "dbclient.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh",
            "en"
          ],
          "default": "auto",
          "description": "Extension language. auto follows VS Code display language.",
          "markdownDescription": "扩展语言。`auto` 跟随 VS Code 显示语言。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbclient",
          "title": "DB Client",
          "icon": "resources/logo.svg"
        }
      ]
    },
    "views": {
      "dbclient": [
        {
          "id": "dbclient.explorer",
          "name": "%view.explorer%"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dbclient.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus"
      },
      {
        "command": "dbclient.runQueryInNewPanel",
        "key": "ctrl+alt+enter",
        "mac": "cmd+ctrl+enter",
        "when": "editorTextFocus"
      },
      {
        "command": "dbclient.explainQuery",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js && cd webview && npx vite build",
    "build:ext": "node esbuild.js",
    "build:webview": "cd webview && npx vite build",
    "dev": "node esbuild.js --watch",
    "dev:webview": "cd webview && npx vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "package": "@vscode/vsce package --no-dependencies --allow-missing-repository"
  },
