{
  "name": "@db-client/server",
  "version": "0.1.0",
  "description": "Sync server for DB Client (Fastify + MySQL + JWT)",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/mysql": "^5.0.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^8.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "mysql2": "3.23.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
