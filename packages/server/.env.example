# 复制为 .env（本地运行）或 .env.production（deploy.sh 推送用）后填写。
# 两者已被 gitignore；本文件是入库的模板，不要写入真实凭据。
#
# 本项目**不区分开发与生产口径**：两份文件都按生产标准配置，键集合完全一致。
# 由此带来三个必须知道的后果：
#
# 1. NODE_ENV=production 会启用真实 SMTP 发信（非 production 时固定用只写日志的
#    stub）。所以本机 pnpm dev 注册测试账号会**真的发出邮件**。
# 2. 登录要求邮箱已验证，而验证码只经邮件下发 —— SMTP 配错等于"能注册、永远登不进"。
# 3. 缺少签名密钥、或 production 下缺 SMTP_HOST，都会**启动即失败**（刻意如此，
#    不静默降级到弱配置）。

# ── Ed25519 token 签名密钥（必填）──
# 密钥绝不入库。生成一套：
#   openssl genpkey -algorithm ed25519 -out k1.pem
#   openssl pkey -in k1.pem -pubout -out k1.pub.pem
#   TOKEN_SIGNING_KEY_B64=$(base64 -w0 k1.pem)
#   TOKEN_VERIFY_KEYS_JSON="{\"k1\":\"$(base64 -w0 k1.pub.pem)\"}"
# 每份环境用独立密钥，不要跨环境复用。
# 轮换：先把新公钥加进 TOKEN_VERIFY_KEYS_JSON，再切 TOKEN_SIGNING_KID，
# 等旧 access token 全部过期（≤ ACCESS_TOKEN_EXPIRES_IN）后移除旧公钥。
# 启动时会校验：必须是 Ed25519，且 KID 对应的公私钥匹配。
TOKEN_SIGNING_KEY_B64=
TOKEN_VERIFY_KEYS_JSON=
TOKEN_SIGNING_KID=k1

# ── 运行环境 ──
NODE_ENV=production
PORT=3000

# ── MySQL ──
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=dbclient
MYSQL_PASSWORD=
MYSQL_DATABASE=db_client
# 池大小，默认 20。单请求内串行查询 2~12 次，过小会在并发高峰表现为整体变慢。
MYSQL_POOL_SIZE=20

# ── MySQL TLS ──
# 不设任何 MYSQL_SSL* 即**明文连接**，仅适合回环 / 可信内网。
# 跨网络（托管 RDS 等）务必启用，否则握手期的账号密码，以及 payload 里的
# password_hash、各类 token_hash、E2E ciphertext 全部无加密、无完整性保护。
#
# 给出 CA 文件即隐含启用，无需再设 MYSQL_SSL：
# MYSQL_SSL_CA_FILE=/path/to/ca.pem
# MYSQL_SSL_CA=-----BEGIN CERTIFICATE-----...   # 或直接给 PEM 内容
# MYSQL_SSL=true                                # 无 CA、使用系统根证书时
# MYSQL_SSL_SERVERNAME=                         # 证书 CN/SAN 与连接地址不一致时
# 下面这项置 false 会**关闭证书校验**：链路仍加密但不防中间人，仅限临时排查。
# MYSQL_SSL_REJECT_UNAUTHORIZED=false
#
# 注意：若 MySQL 服务端未开启 TLS（have_ssl=DISABLED），启用后会
# HANDSHAKE_NO_SSL_SUPPORT 导致连不上 —— 需先在服务端开启 SSL。

# ── 邮件投递（NODE_ENV=production 时必填）──
# 587 + STARTTLS，或 465 + SMTP_SECURE=true。多数云厂商封 25 端口。
# SMTP_SECURE=false 时代码会强制 requireTLS：TLS 升级失败即报错，
# 绝不退回明文发送（一次性 token 等同账号控制权，不能明文过网）。
# 部分邮箱（QQ / 163 等）SMTP_PASS 填的是"授权码"，不是登录密码。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 邮件内一次性链接的域名前缀（验证 / 邀请 / sync-reset 三类链接共用）。
SMTP_BASE_URL=https://your-domain.example

# ── Token 有效期 ──
# 格式 \d+[smhd]；ACCESS 上限 1h、REFRESH 上限 90d。非法值或超限**启动失败**
# （纯数字被拒绝：秒与毫秒语义有歧义）。
# access 设短不会让用户重新登录：客户端遇 401 会用 refresh token 静默续期。
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ── 反向代理 ──
# 信任几跳代理，决定 req.ip（限流分桶键与 devices.ip 的来源）。
#   nginx 反代之后 → 1
#   直连暴露、无代理 → false（否则任何客户端都能用 X-Forwarded-For 伪造 IP，
#                            按 IP 的限流全部失效）
# TRUST_PROXY=true 会被**拒绝启动**：它取 XFF 最左段，而那段完全由客户端控制。
# 可直接使用的反代配置见 nginx.conf.example。
TRUST_PROXY=1

# ── CORS ──
# 通常**无需设置**：VS Code 扩展走 Node fetch，不受浏览器 CORS 约束。
# 留空 = 拒绝所有跨域，最严也最正确。仅当有浏览器端页面直连本服务时才填其源。
# CORS_ORIGIN=https://your-domain.example

# ── 限流 ──
# 逃生开关：万一阈值配错把所有人挡在门外，设 false 重启即全面放行
# （不依赖数据库或后台）。阈值本身是代码常量（authService 的 LOGIN_* 等），
# 计数存于 MySQL rate_limit_entries，跨实例共享。
RATE_LIMIT_ENABLED=true

# ── 平台管理员（P3 切片 4）──
# 仅作首次受控引导来源：逗号分隔邮箱，启动时把「已注册」用户提升为 platform_admin。
# 缺失 = 平台运营失败关闭（无人自动提升、/api/console/admin/* 一律 403）。
# 注意：此处打错字/用户尚未注册会被启动日志 warn 提示；移除某项不降级已提升账号。
# PLATFORM_ADMIN_EMAILS=admin@example.com,ops@example.com

# ── sync-reset 深链扩展 id（P3 切片 5）──
# 浏览器签发的深链为 vscode://<SYNC_EXTENSION_ID>/reset-after-loss?handoffTicket=。
# 当前扩展 manifest 的 publisher.name = lang2hong.vscode-db-client（默认，开箱即用）。
# 若日后以 dbclient.sync 重新发布，改此值为新 id 即可。
SYNC_EXTENSION_ID=lang2hong.vscode-db-client

# ── 支付（P4 切片 4）──
# 支付是异步通知：渠道必须把**非空**回调 URL 交给平台，否则已付款订单永不履约。
# 回调基础 URL 必须是 HTTPS 裸 origin（无路径/query/fragment）。缺失或不合法时，
# 微信/支付宝渠道均视为「未配置」，下单与回调路由 fail-closed 不注册。
PAYMENT_CALLBACK_BASE_URL=https://your-domain.example

# 功能开关（P4 §11.4）：false/0/off 关闭；关闭时下单与回调返回 503，不回退弱路径。
# 当前仅 FEATURE_PAYMENT 已接线；其余三项为预留命名，暂不产生运行时行为。
# FEATURE_PAYMENT=false

# 微信支付（API v3 Native）。证书/私钥绝不入库，用 base64 编码 PEM 注入。
#   WECHAT_PRIVATE_KEY_B64=$(base64 -w0 apiclient_key.pem)   # 商户私钥 PKCS8 PEM
#   WECHAT_PLATFORM_CERT_B64=$(base64 -w0 wechatpay_cert.pem) # 平台证书 SPKI PEM
# WECHAT_MERCHANT_CERT_SERIAL 是商户证书序列号（16 进制），v3 Authorization 必填。
# WECHAT_API_V3_KEY 必须**恰好 32 字节**（AES-256-GCM 回调解密用），不截断、不接受短/长值。
# 任一缺失 → 微信渠道未配置。
# WECHAT_MCH_ID=
# WECHAT_APP_ID=
# WECHAT_MERCHANT_CERT_SERIAL=
# WECHAT_PRIVATE_KEY_B64=
# WECHAT_PLATFORM_CERT_B64=
# WECHAT_API_V3_KEY=

# 支付宝（网页 H5）。RSA2 签名/验签。
#   ALIPAY_PRIVATE_KEY_B64=$(base64 -w0 app_private_key.pem)  # 应用私钥 PKCS8 PEM
#   ALIPAY_PUBLIC_KEY_B64=$(base64 -w0 alipay_public_key.pem) # 支付宝公钥 SPKI PEM
# 任一缺失 → 支付宝渠道未配置。
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY_B64=
# ALIPAY_PUBLIC_KEY_B64=

# ── 上线前逐项确认 ──
#   TOKEN_SIGNING_KEY_B64 / TOKEN_VERIFY_KEYS_JSON  已生成且未跨环境复用
#   NODE_ENV=production                             否则 CORS 会反射任意来源
#   SMTP_*                                          verify 通过（否则注册后无法登录）
#   MYSQL_PASSWORD                                  非空
#   MYSQL_SSL_CA_FILE                               跨网络时必须启用
#   TRUST_PROXY                                     nginx 后用 1，切勿用 true
#   数据库字符集                                     必须 utf8mb4；DBA 预建库时需显式指定，
#                                                   否则继承服务器默认（很多 MySQL 8 仍是
#                                                   utf8mb3），连接名/设备名带 emoji 会写入失败
#
# 跑集成测试时另需（务必指向专用验证库，那些测试会建表并做全表 DELETE）：
#   MYSQL_TEST_URL=mysql://user:urlencoded_pwd@host:3306
#   MYSQL_TEST_DB=db_client_verify
# 测试侧有硬门禁：库名与 MYSQL_DATABASE 相同、或不含 verify/test 时拒绝启动。
