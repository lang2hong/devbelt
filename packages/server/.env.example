# 复制为 .env 后修改（.env 已被 gitignore，密码不会入库）
#
# 只有 MYSQL_PASSWORD 与 JWT_SECRET 必须自己填，其余留空即用注释里的默认值。
# 完整说明见 README.md 的「环境变量」小节。

# ── 必填 ──────────────────────────────────────────────
# MySQL 密码。docker compose 下会同时用于创建 dbclient 用户
MYSQL_PASSWORD=here-your-password
# JWT 签名密钥。NODE_ENV=production 时缺失、为已知弱值、或短于 32 字符都会导致
# 启动失败。生成：openssl rand -base64 48
# 与密码哈希已完全解耦（legacy sha256 分支已删除），轮换的唯一代价是所有人重新登录。
JWT_SECRET=your-strong-secret-here

# ── MySQL 连接 ────────────────────────────────────────
# 默认 127.0.0.1；docker compose 会覆盖为服务名 mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
MYSQL_USER=dbclient
MYSQL_DATABASE=db_client

# MySQL 容器 root 密码，仅 docker compose 初始化时使用（默认 rootpass）
# MYSQL_ROOT_PASSWORD=rootpass

# ── 服务 ──────────────────────────────────────────────
# PORT=3000
# 设为 production 后：JWT_SECRET 变必填，CORS 改为按 CORS_ORIGIN 白名单
# NODE_ENV=production

# ── Token 有效期 ──────────────────────────────────────
# 格式为 \d+[smhd]，非法值或超出上限会导致**启动失败**（不再静默回落）。
# ACCESS 上限 1h，REFRESH 上限 90d。纯数字被拒绝（单位歧义）。
# access 短不会让用户重新登录：客户端 401 时用 refresh token 静默换新。
# ACCESS_TOKEN_EXPIRES_IN=15m
# REFRESH_TOKEN_EXPIRES_IN=30d

# ── CORS ──────────────────────────────────────────────
# 仅生产生效。不设置则拒绝所有跨域请求；非生产环境恒为放行
# CORS_ORIGIN=https://your-domain.example

# ── 反向代理 ──────────────────────────────────────────
# 信任几跳代理，决定 req.ip（限流分桶键 + devices.ip 来源）。
# 默认 1，假定部署在 nginx 反代之后。可直接用的配置见 nginx.conf.example。
#
# 本项目的两种部署形态：
#   开发（直连暴露，无代理） → TRUST_PROXY=false
#   生产（nginx 反代）        → TRUST_PROXY=1
#
# 直连暴露时若不设 false，任何客户端都能用 X-Forwarded-For 头伪造自己的 IP，
# 按 IP 的限流全部失效。
#
# 注意 true 会被拒绝启动：它取 XFF 最左段，而最左段完全由客户端控制。
# 要信任代理请用跳数（1）或代理地址（127.0.0.1）。
# TRUST_PROXY=1

# ── 生产上线清单 ──────────────────────────────────────
# 逐项确认，缺一项都会留下已知缺陷：
#
#   NODE_ENV=production      必设。否则 CORS 走 origin:true（反射任意来源），
#                            且 JWT_SECRET 的强度校验降级为仅告警。
#   JWT_SECRET               openssl rand -base64 48。生产拒绝已知弱值与 <32 字符。
#   TRUST_PROXY=1            见上。nginx 之后用 1，不要用 true。
#   MYSQL_PASSWORD           不要留空。
#   CORS_ORIGIN              通常**无需设置**：admin-ui 由 server 在 /admin/ 同源
#                            托管（api.ts 用相对路径），VS Code 扩展走 Node fetch
#                            不受浏览器 CORS 约束。不设 → 拒绝所有跨域，是最严也
#                            是正确的配置。仅当 admin-ui 独立部署到别的域名时才设。
#   ACCESS_TOKEN_EXPIRES_IN  建议 15m。客户端 401 会自动用 refresh token 静默换新，
#                            用户不会因此重新登录。
#
# 两条与配置无关但同样属于上线前置条件的事：
#
#   至少两个 admin 账号。服务端拒绝降级/禁用最后一个还能登录的 admin，
#   也拒绝 admin 降级自己 —— 这是为了避免"点错一次就得连生产库改 users.role"。
#   只有一个 admin 时，把权限转交给别人必须先提权对方、再由对方降级自己。
#
#   库的字符集必须是 utf8mb4。服务只在库不存在时才带 utf8mb4 建库；DBA 预建的
#   库若用了服务器默认（不少 MySQL 8 实例仍是 utf8mb3），表会继承成 utf8mb3，
#   用户在连接名/设备名里输入 emoji 时**写入直接失败**。启动日志会列出所有
#   非 utf8mb4 的表，按提示在维护窗口执行 CONVERT TO CHARACTER SET。

# ── 限流 ──────────────────────────────────────────────
# 阈值在 /admin 后台的 Limits 页实时调整（写 DB + 内存，无需重启），
# 默认值见 src/ratelimit/rules.ts。
#
# 这个开关是逃生通道：万一阈值配错把所有人（包括管理员）锁在门外，
# 后台也进不去改不了 DB，此时设为 false 重启即可全面放行。
# RATE_LIMIT_ENABLED=true

# ── 事件表清理 ────────────────────────────────────────
# sync_events / usage_events / device_events / traffic_blocked 这几张留痕表
# 只增不减：sync_events 每次 pull/push 一行，一个开自动同步的客户端每小时
# 约 60 行，100 用户一天约 14 万行，而没有任何业务逻辑读历史行。
# 清理任务在启动时跑一轮，之后按间隔重复；每批 DELETE 限 2000 行（短事务，
# 避免长时间持锁与主从延迟）。refresh_tokens 里早已失效的行一并回收。
#
# 保留天数。0 = 关闭清理（排查问题期间不想丢留痕时用）。默认 90。
# 非法值（非整数/负数）会让启动失败，不会静默回落。
# EVENT_RETENTION_DAYS=90
#
# 两轮清理之间的间隔（小时），最小 1，默认 24。
# MAINTENANCE_INTERVAL_HOURS=24
