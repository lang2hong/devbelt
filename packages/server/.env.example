# 复制为 .env 后修改（.env 已被 gitignore，密码不会入库）
#
# 必填：MYSQL_PASSWORD 与 Ed25519 签名密钥（TOKEN_SIGNING_KEY_B64 / TOKEN_VERIFY_KEYS_JSON）。
# 其余留空即用注释里的默认值。完整说明见 README.md 的「环境变量」小节。

# ── 必填 ──────────────────────────────────────────────
# MySQL 密码。docker compose 下会同时用于创建 dbclient 用户
MYSQL_PASSWORD=here-your-password
# Ed25519 access token 签名密钥（V3 取代 HS256 JWT_SECRET，实施规格 §4.5）。
# 密钥绝不入库；缺失任一签名相关配置都会导致启动失败，不回退到不签名/弱密钥。
#   - TOKEN_SIGNING_KEY_B64：当前签名私钥（PKCS8 PEM 的 base64）
#   - TOKEN_VERIFY_KEYS_JSON：公钥集 {"<kid>":"<SPKI PEM base64>", ...}，供验签与轮换
#   - TOKEN_SIGNING_KID：当前签名 key id（默认 k1）
# 生成 k1 私钥与对应公钥：
#   openssl genpkey -algorithm ed25519 -out /tmp/k1.pem
#   openssl pkey -in /tmp/k1.pem -pubout -out /tmp/k1.pub.pem
#   TOKEN_SIGNING_KEY_B64=$(base64 -w0 /tmp/k1.pem)
#   TOKEN_VERIFY_KEYS_JSON="{\"k1\":\"$(base64 -w0 /tmp/k1.pub.pem)\"}"
# 轮换：先加新公钥并切换 TOKEN_SIGNING_KID，等旧 access token 全部过期后再移除旧公钥。
TOKEN_SIGNING_KEY_B64=
TOKEN_VERIFY_KEYS_JSON=
# TOKEN_SIGNING_KID=k1

# ── MySQL 连接 ────────────────────────────────────────
# 默认 127.0.0.1；docker compose 会覆盖为服务名 mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
MYSQL_USER=dbclient
MYSQL_DATABASE=db_client

# MySQL 容器 root 密码，仅 docker compose 初始化时使用（默认 rootpass）
# MYSQL_ROOT_PASSWORD=rootpass

# ── 服务 ──────────────────────────────────────────────
# PORT=3000
# 设为 production 后：CORS 改为按 CORS_ORIGIN 白名单（签名密钥无论环境都必填）
# NODE_ENV=production

# ── 邮件投递（实施规格 §4.7，可选：未配置 SMTP_HOST 时用 LogEmailSender 只记日志）──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
# SMTP_BASE_URL=https://your-domain.example

# ── Token 有效期 ──────────────────────────────────────
# 格式为 \d+[smhd]，非法值或超出上限会导致**启动失败**（不再静默回落）。
# ACCESS 上限 1h，REFRESH 上限 90d。纯数字被拒绝（单位歧义）。
# access 短不会让用户重新登录：客户端 401 时用 refresh token 静默换新。
# ACCESS_TOKEN_EXPIRES_IN=15m
# REFRESH_TOKEN_EXPIRES_IN=30d

# ── CORS ──────────────────────────────────────────────
# 仅生产生效。不设置则拒绝所有跨域请求；非生产环境恒为放行
# CORS_ORIGIN=https://your-domain.example

# ── 反向代理 ──────────────────────────────────────────
# 信任几跳代理，决定 req.ip（限流分桶键 + devices.ip 来源）。
# 默认 1，假定部署在 nginx 反代之后。可直接用的配置见 nginx.conf.example。
#
# 本项目的两种部署形态：
#   开发（直连暴露，无代理） → TRUST_PROXY=false
#   生产（nginx 反代）        → TRUST_PROXY=1
#
# 直连暴露时若不设 false，任何客户端都能用 X-Forwarded-For 头伪造自己的 IP，
# 按 IP 的限流全部失效。
#
# 注意 true 会被拒绝启动：它取 XFF 最左段，而最左段完全由客户端控制。
# 要信任代理请用跳数（1）或代理地址（127.0.0.1）。
# TRUST_PROXY=1

# ── 生产上线清单 ──────────────────────────────────────
# 逐项确认，缺一项都会留下已知缺陷：
#
#   NODE_ENV=production      必设。否则 CORS 走 origin:true（反射任意来源）。
#   TOKEN_SIGNING_KEY_B64    必填（PKCS8 PEM 的 base64），缺失启动即失败。
#   TOKEN_VERIFY_KEYS_JSON   必填（含当前 TOKEN_SIGNING_KID 的公钥），缺失启动即失败。
#   TRUST_PROXY=1            见上。nginx 之后用 1，不要用 true。
#   MYSQL_PASSWORD           不要留空。
#   SMTP_HOST                Phase 1 生产应配置，否则验证邮件只写日志不真正投递。
#   CORS_ORIGIN              通常**无需设置**：VS Code 扩展走 Node fetch 不受浏览器
#                            CORS 约束。不设 → 拒绝所有跨域，是最严也最正确的配置。
#   ACCESS_TOKEN_EXPIRES_IN  建议 15m。客户端 401 会自动用 refresh token 静默换新，
#                            用户不会因此重新登录。
#
# 一条与配置无关但同样属于上线前置条件的事：
#
#   跑集成测试时务必设 MYSQL_TEST_DB=dbclient_verify。那些测试会建表、加索引、
#   做全表 DELETE —— 指到生产库就是数据事故。测试侧已加硬门禁（库名与
#   MYSQL_DATABASE 相同或不含 verify/test 时直接拒绝启动），但不要依赖它。
#
#   库的字符集必须是 utf8mb4。服务只在库不存在时才带 utf8mb4 建库；DBA 预建的
#   库若用了服务器默认（不少 MySQL 8 实例仍是 utf8mb3），表会继承成 utf8mb3，
#   用户在连接名/设备名里输入 emoji 时**写入直接失败**。所有表 DDL 自带
#   utf8mb4_0900_ai_ci，但库级 collation 仍需 DBA 在预建时指定 utf8mb4。

# ── 限流 ──────────────────────────────────────────────
# V3 阈值回归代码常量（src/service/authService.ts 的 LOGIN_* / REGISTER_* /
# VERIFY_RESEND_*），计数存于 MySQL rate_limit_entries（跨实例共享，实施规格 §4.5）。
#
# 这个开关是逃生通道：万一阈值配错把所有人锁在门外，此时设为 false 重启即可全面
# 放行（不依赖任何 DB 或后台）。
# RATE_LIMIT_ENABLED=true
