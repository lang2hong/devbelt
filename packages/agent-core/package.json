{
  "name": "@devbelt/agent-core",
  "version": "0.1.0",
  "private": true,
  "description": "Agent tool policy, proposal state machine and execution ledger (no vscode dependency)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm -C ../db-core build && pnpm -C ../ai-core build && vitest run"
  },
  "dependencies": {
    "@devbelt/ai-core": "workspace:*",
    "@devbelt/db-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
